# ==================================================
# PRAMĀṆA — Environment Variables
# ==================================================
# Copy this file to .env and fill in the values.
# Lines marked [REQUIRED] must be set before the app will function.
# Lines marked [OPTIONAL] enhance functionality but have defaults.
# ==================================================

# --- Server ---
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# --- PostgreSQL [REQUIRED] ---
# If using Docker Compose, these defaults match docker-compose.yml
DATABASE_URL=postgresql://pramana:pramana_dev@localhost:5433/pramana
PGHOST=localhost
PGPORT=5433
PGUSER=pramana
PGPASSWORD=pramana_dev
PGDATABASE=pramana

# --- Neo4j [REQUIRED] ---
# If using Docker Compose, these defaults match docker-compose.yml
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pramana_neo4j_dev

# --- Firebase Authentication [REQUIRED] ---
# Create a Firebase project at https://console.firebase.google.com
# Enable Google sign-in under Authentication → Sign-in method
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Frontend Firebase config (safe to expose — these are public identifiers)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Google Gemini API [REQUIRED] ---
GEMINI_API_KEY=

# --- News Sources ---
# NewsAPI.org [OPTIONAL] — get a key at https://newsapi.org
NEWSAPI_KEY=

# GDELT — no key required, public API
# RSS feeds — configured in server/src/config/sources.js

# --- Session / Security ---
SESSION_SECRET=change-this-to-a-random-64-char-string
CORS_ORIGIN=http://localhost:5173

# --- Rate Limiting [OPTIONAL] ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Ingestion [OPTIONAL] ---
INGESTION_INTERVAL_MINUTES=15
INGESTION_MAX_RETRIES=3
